---
import LinkArrow from "@components/LinkArrow.astro";
import Layout from "@layouts/Layout.astro";
---

<Layout>
  <div class="w-full max-w-2xl mx-auto mt-24 px-4">
    <h1 class="font-heading text-4xl sm:text-5xl font-bold tracking-tight text-zinc-100 mb-6">
      404: <del class="line-through decoration-zinc-500 text-zinc-500">gravity</del> <span class="italic">page</span> not found
    </h1>
    <LinkArrow link="/" text="Houston, take me back home" />
  </div>
</Layout>
