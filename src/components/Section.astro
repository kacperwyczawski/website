---
export interface Props {
  heading: string;
}

const { heading } = Astro.props;
---

<section class="mb-14 sm:mb-16 last:mb-0">
  <h2 class="font-heading text-3xl sm:text-4xl font-semibold text-zinc-100 tracking-tight leading-tight mb-6" id={heading}>
    {heading}
  </h2>
  <slot />
</section>
