---
import { Image } from "astro:assets";
---

<div
  class="relative flex w-full shrink-0 items-end justify-center overflow-hidden bg-zinc-950 transition-[max-width,margin] duration-300"
  id="frame"
>
  <canvas
    id="art"
    class="mx-auto block aspect-[200/var(--art-rows,122)] h-auto w-screen shrink-0 origin-bottom will-change-transform"
  ></canvas>
  <div class="hero-overlay pointer-events-none absolute left-8 top-8 z-5 will-change-transform max-sm:left-5 max-sm:right-5 max-sm:top-5">
    <h1 class="m-0 p-0 leading-none" id="heroTitle">
      <Image
        src="/hero-title.svg"
        alt="Kacper Wyczawski"
        class="hero-title block h-auto select-none pointer-events-none"
        width={713}
        height={199}
        priority
        decoding="async"
      />
    </h1>
  </div>
</div>

<style>
  /* Base Desktop Title Size */
  .hero-title {
    width: clamp(280px, 54vw, 713px);
    max-width: calc(100vw - 2.5rem);
  }

  /* Vertical / Portrait Mode (Tablets & Mobile) */
  @media (orientation: portrait) {
    #frame {
      height: calc(100vh + var(--track-extra, 10vw));
      min-height: calc(100vh + var(--track-extra, 10vw));

      @media (width <= 680px) {
        --track-extra: 15vw;
      }
    }

    #art {
      position: absolute;
      bottom: 0;
      left: 0;
      max-width: none;
      width: var(--art-width, 200vw);
      transform: translateX(var(--art-shift, -35%));

      @media (width <= 680px) {
        --art-width: 300vw;
        --art-shift: -51%;
      }
    }

    .hero-title {
      width: clamp(380px, 66vw, 680px);
      max-width: 100%;

      @media (width <= 680px) {
        width: 100%;
      }
    }
  }
</style>

<script>
  import { BASE_W, BASE_H, MIN_GROUND_ROW, BASE_TOP, GROUND_DATA_B64, EARTH_TEX_B64 } from "./earthrise-data";

  const baseMeta = {
    cols: 200,
    fps: 15,
    ground: "#09090b",
    palette: [
      "#18181b",
      "#232326",
      "#303033",
      "#414143",
      "#555556",
      "#6b6a69",
      "#83817d",
      "#9c9993",
      "#b6b2aa",
      "#cfcac1",
      "#e6e1d8",
      "#f7f4ee",
      "#0c1120",
      "#131a2e",
      "#1b2540",
      "#262f4a",
      "#dfe9ff",
      "#0a2259",
      "#0f2f72",
      "#15408c",
      "#1d53a6",
      "#2a69bf",
      "#4386d3",
      "#6eaeea",
      "#a8d3f6",
      "#e8f0fa",
      "#c2d0e3",
      "#8b9fbc",
      "#2f4a26",
      "#3b5a2c",
      "#5b7238",
      "#7a9150",
      "#77783f",
      "#8f8550",
      "#a8955e",
      "#6b5634",
      "#b9774a",
      "#8a4838",
    ],
  };

  const SUN = (() => {
    const v = [0.94, 0.14, -0.3];
    const l = Math.hypot(...v);
    return v.map((c) => c / l);
  })();

  const L = [SUN[0], SUN[1], -SUN[2]];
  const HV = (() => {
    const v = [L[0], L[1], L[2] + 1];
    const l = Math.hypot(...v);
    return v.map((c) => c / l);
  })();
  const tilt = 0.4,
    nod = 0.22;
  const ct = Math.cos(tilt),
    st = Math.sin(tilt),
    cn = Math.cos(nod),
    sn = Math.sin(nod);

  const clamp = (v: number) => (v < 0 ? 0 : v > 1 ? 1 : v);
  const smooth = (a: number, b: number, v: number) => {
    const k = clamp((v - a) / (b - a));
    return k * k * (3 - 2 * k);
  };
  const mix = (a: number, b: number, k: number) => a + (b - a) * k;
  const hex = (s: string) => [1, 3, 5].map((i) => parseInt(s.slice(i, i + 2), 16) / 255);

  const P = baseMeta.palette.map(hex);
  const COVER = [0, 0.3, 0.6, 1];
  const BAYER = [0, 8, 2, 10, 12, 4, 14, 6, 3, 11, 1, 9, 15, 7, 13, 5].map((v) => v / 16 - 0.47);

  const lut = new Uint8Array(32768).fill(255);
  const nearest = (r: number, g: number, b: number) => {
    const k = (Math.min(31, (r * 31.99) | 0) << 10) | (Math.min(31, (g * 31.99) | 0) << 5) | Math.min(31, (b * 31.99) | 0);
    if (lut[k] !== 255) return lut[k];
    let best = 0,
      bd = 1e9;
    for (let i = 0; i < P.length; i++) {
      const dr = P[i][0] - r,
        dg = P[i][1] - g,
        db = P[i][2] - b;
      const d = 0.3 * dr * dr + 0.5 * dg * dg + 0.2 * db * db;
      if (d < bd) ((bd = d), (best = i));
    }
    return (lut[k] = best);
  };

  function hash(x: number, y: number) {
    let h = Math.imul(x | 0, 374761393) + Math.imul(y | 0, 668265263);
    h = Math.imul(h ^ (h >>> 13), 1274126177);
    return ((h ^ (h >>> 16)) >>> 0) / 4294967296;
  }

  function decodeBase64(b64: string): Uint8Array {
    const bin = atob(b64);
    const len = bin.length;
    const bytes = new Uint8Array(len);
    for (let i = 0; i < len; i++) bytes[i] = bin.charCodeAt(i);
    return bytes;
  }

  // Pre-decoded assets: base ground & earth textures (0.1ms decode)
  const groundData = decodeBase64(GROUND_DATA_B64);
  const rawTex = decodeBase64(EARTH_TEX_B64);
  const TW = 192,
    TH = 96,
    N_TEX = TW * TH;
  const tr = new Float32Array(N_TEX),
    tg = new Float32Array(N_TEX),
    tb = new Float32Array(N_TEX),
    sea = new Float32Array(N_TEX),
    cloud = new Float32Array(N_TEX);
  const inv255 = 1 / 255;
  for (let i = 0; i < N_TEX; i++) {
    tr[i] = rawTex[i] * inv255;
    tg[i] = rawTex[N_TEX + i] * inv255;
    tb[i] = rawTex[N_TEX * 2 + i] * inv255;
    sea[i] = rawTex[N_TEX * 3 + i] * inv255;
    cloud[i] = rawTex[N_TEX * 4 + i] * inv255;
  }

  const sample = (A: Float32Array, lon: number, vy: number) => {
    const fx = ((((lon / (Math.PI * 2)) % 1) + 1) % 1) * TW;
    const x0 = Math.floor(fx),
      ax = fx - x0,
      x1 = (x0 + 1) % TW;
    const y0 = Math.max(0, Math.min(TH - 2, Math.floor(vy))),
      ay = clamp(vy - y0);
    const a = A[y0 * TW + x0],
      b = A[y0 * TW + x1],
      c = A[y0 * TW + TW + x0],
      d = A[y0 * TW + TW + x1];
    return a + (b - a) * ax + (c - a) * ay + (a - b - c + d) * ax * ay;
  };

  function createEarthrise(H: number, extraSky = 0) {
    const W = BASE_W;
    const N = W * H;

    const densities = new Uint8Array(N);
    const cols = new Uint8Array(N);
    const sr = new Float32Array(N),
      sg = new Float32Array(N),
      sb = new Float32Array(N),
      scap = new Float32Array(N).fill(1);

    const dot = (k: number, x: number, r: number, cr: number, cg: number, cb: number, floor: number, cap: number) => {
      const peak = Math.max(cr, cg, cb, 1e-4);
      const level = clamp(floor + (1 - floor) * Math.pow(peak, 0.85) * 0.95);
      const step = Math.max(0, Math.min(3, Math.round(level * 3 + BAYER[(r & 3) * 4 + (x & 3)])));
      densities[k] = step;
      const want = step ? Math.min(1, (level + 0.06) / COVER[step]) : 0;
      const s = Math.min(cap, 0.3 + 0.7 * want) / peak;
      cols[k] = nearest(clamp(cr * s), clamp(cg * s), clamp(cb * s));
    };

    // 1. Unpack precomputed ground (aligned to desktop baseline)
    const extraRows = Math.max(0, extraSky - 10);
    const top = new Int16Array(W);
    for (let x = 0; x < W; x++) {
      const topR = BASE_TOP[x] + extraRows;
      top[x] = topR;
      for (let r = topR; r < H; r++) {
        const k = r * W + x;
        const b = groundData[(r - extraRows - MIN_GROUND_ROW) * W + x];
        densities[k] = b & 3;
        cols[k] = b >> 2;
      }
    }

    // 2. Exact star placement (100% mathematical parity with original)
    const EC = [141, 37 + extraSky];
    const ER = 22;
    const near = (x: number, r: number) => {
      const dx = x + 0.5 - EC[0];
      const dy = r + 0.5 - EC[1];
      return Math.hypot(dx, dy) < ER + 8 || (Math.abs(dx) < ER + 4 && r >= EC[1] - 12 && r <= EC[1] + 32);
    };

    for (let r = 0; r < H; r++) {
      for (let x = 0; x < W; x++) {
        const k = r * W + x;
        if (r >= top[x]) continue; // ground
        let cr = 0,
          cg = 0,
          cb = 0,
          cap = 1;
        const hs = hash(x * 3 + 1, r * 7 + 2);
        if (hs > 0.9975 && !near(x, r) && r < H - 15) {
          const m = Math.pow(hash(x + 17, r + 29), 3);
          const s = 0.2 + 0.5 * m;
          const tint = hash(x + 5, r + 77);
          const [trCol, tgCol, tbCol] = tint < 0.3 ? [0.84, 0.9, 1] : tint > 0.88 ? [1, 0.93, 0.84] : [0.96, 0.96, 0.98];
          cr = s * trCol;
          cg = s * tgCol;
          cb = s * tbCol;
        }
        sr[k] = cr;
        sg[k] = cg;
        sb[k] = cb;
        scap[k] = cap;
        dot(k, x, r, cr, cg, cb, 0, cap);
      }
    }

    // 3. Bright stars & twinkle
    const BRIGHT = [
      [24, 10 + extraSky, 1, 4.6],
      [67, 30 + extraSky, 0.85, 3.4],
      [99, 14 + extraSky, 0.95, 5.8],
      [189, 8 + extraSky, 0.8, 4.1],
    ];

    const twinkle: [number, number, number, number, number, number, boolean][] = [];
    for (const [x, r, s, p] of BRIGHT) {
      for (const [ox, oy, w] of [
        [0, 0, 1],
        [-1, 0, 0.2],
        [1, 0, 0.2],
        [0, -1, 0.2],
        [0, 1, 0.2],
      ]) {
        const cy = r + oy,
          cx = x + ox;
        if (cy >= 0 && cy < top[cx] && cx >= 0 && cx < W) {
          const k = cy * W + cx;
          twinkle.push([k, cx, cy, s * w, p, hash(x, r) * 6.28, w === 1]);
        }
      }
    }

    // 4. Dynamic Earth box
    const LON0 = 3.5;
    const RISE = 5,
      RISE_T = 150;
    const box: number[] = [];
    const MAX_OFFSET = 32;
    for (let r = Math.max(0, EC[1] - RISE - ER - 6); r <= Math.min(H - 1, EC[1] + MAX_OFFSET + ER + 4); r++) {
      for (let x = EC[0] - ER - 8; x <= EC[0] + ER + 8; x++) {
        if (r < top[x]) box.push(r * W + x);
      }
    }

    const render = (t: number, { parallaxOffset = 0 } = {}) => {
      const spin = t * 0.045;
      const drift = t * 0.012;
      const ey = EC[1] - RISE * (0.5 - 0.5 * Math.cos((t / RISE_T) * Math.PI * 2)) + parallaxOffset;

      for (const k of box) {
        const x = k % W,
          r = (k / W) | 0;
        let cr = sr[k],
          cg = sg[k],
          cb = sb[k],
          cap = scap[k],
          floor = 0;
        const dx = x + 0.5 - EC[0],
          dy = r + 0.5 - ey;
        const dist = Math.hypot(dx, dy);

        if (dist >= ER - 0.5 && dist < ER + 3.5) {
          const side = smooth(0.1, 0.8, (dx * L[0] - dy * L[1]) / dist);
          let g = Math.exp(-Math.max(0, dist - ER) / 0.85) * 0.7 * side;
          if (g < 0.08) g = 0;
          cr += 0.25 * g;
          cg += 0.52 * g;
          cb += 1.0 * g;
          if (g > 0) cap = 1;
        }

        if (dist < ER) {
          const nx = dx / ER,
            ny = -dy / ER,
            q2 = nx * nx + ny * ny;
          const nz = Math.sqrt(1 - q2);
          const ax = nx * ct + ny * st;
          const ay0 = -nx * st + ny * ct;
          const ay = ay0 * cn - nz * sn;
          const az = ay0 * sn + nz * cn;
          const lat = Math.asin(Math.max(-1, Math.min(1, ay)));
          const lon = Math.atan2(ax, az) + LON0 + spin;
          const vy = (0.5 - lat / Math.PI) * TH - 0.5;
          const ndl = nx * L[0] + ny * L[1] + nz * L[2];
          const day = smooth(-0.005, 0.06, ndl) * (0.45 + 0.8 * Math.sqrt(clamp(ndl)));
          const dusk = Math.exp(-(((ndl - 0.02) / 0.035) ** 2));
          const cl = sample(cloud, lon + drift, vy);
          const sh = sample(cloud, lon + drift - 0.03, vy + 0.4);
          const sw = sample(sea, lon, vy);
          let er = sample(tr, lon, vy),
            eg = sample(tg, lon, vy),
            eb = sample(tb, lon, vy);
          const shade = 1 - 0.45 * sh * (1 - cl);
          er *= shade;
          eg *= shade;
          eb *= shade;
          er = mix(er, 0.95, cl);
          eg = mix(eg, 0.97, cl);
          eb = mix(eb, 1.0, cl);
          er *= day * (1 + 0.06 * dusk);
          eg *= day * (1 - 0.03 * dusk);
          eb *= day * (1 - 0.1 * dusk);
          const glint = Math.pow(Math.max(0, nx * HV[0] + ny * HV[1] + nz * HV[2]), 70) * 0.8 * sw * (1 - cl);
          const rim = Math.pow(1 - nz, 2.2) * smooth(0, 0.3, ndl);
          er += glint * 0.95 + rim * 0.2;
          eg += glint * 0.92 + rim * 0.42;
          eb += glint * 0.85 + rim * 0.85;
          const edge = smooth(1, 0.95, Math.sqrt(q2));
          cr = mix(cr, er, edge);
          cg = mix(cg, eg, edge);
          cb = mix(cb, eb, edge);
          cap = mix(1, 0.66, (1 - sw) * (1 - cl) * smooth(0.95, 0.85, Math.abs(ay)));
          floor = 0.15 * Math.min(1, day) * edge;
        }

        dot(k, x, r, cr, cg, cb, floor, cap);
      }

      for (const [k, x, r, s, p, ph, core] of twinkle) {
        const v = s * (0.86 + 0.14 * Math.sin((t / p) * Math.PI * 2 + ph));
        if (core) dot(k, x, r, v * 0.97, v * 0.98, v, 0, 1);
        else dot(k, x, r, v * 0.95, v, v * 1.15, 0, 0.6);
      }

      return { densities, cols };
    };

    // Render frame 0 immediately so first draw is ready
    render(0, { parallaxOffset: 0 });

    return render;
  }

  function mount(
    canvas: HTMLCanvasElement,
    pieceMeta: { cols: number; rows: number; palette: string[]; ground: string; fps?: number },
    makeFrame: () => (t: number, opts?: { parallaxOffset?: number }) => { densities: Uint8Array; cols: Uint8Array },
    initialTime = 0,
  ) {
    const { cols, rows, palette, ground, fps = 15 } = pieceMeta;
    const frame = makeFrame();
    const lastColor = new Uint8Array(cols * rows);
    const lastDensity = new Uint8Array(cols * rows);
    const ctx = canvas.getContext("2d")!;
    const atlas = document.createElement("canvas");
    const actx = atlas.getContext("2d")!;

    let w = 0,
      h = 0,
      sw = 0,
      sh = 0,
      pw = 0,
      ph = 0,
      width = -1;
    let xs = new Int32Array(0),
      ys = new Int32Array(0),
      gx = new Int32Array(0),
      gy = new Int32Array(0);
    let full = true;

    const size = () => {
      width = canvas.clientWidth;
      const dpr = Math.min(window.devicePixelRatio || 1, 3);
      w = (width * dpr) / cols;
      h = w;
      sw = Math.ceil(w);
      sh = Math.ceil(h);
      pw = sw + 2;
      ph = sh + 2;
      canvas.width = Math.round(w * cols);
      canvas.height = Math.round(h * rows);
      ctx.imageSmoothingEnabled = false;

      // Pre-render all 114 glyphs in the atlas (3 steps * 38 colors)
      atlas.width = pw * 32;
      atlas.height = ph * 4;
      actx.imageSmoothingEnabled = false;
      actx.clearRect(0, 0, atlas.width, atlas.height);

      for (let step = 1; step <= 3; step++) {
        const r = step === 1 ? Math.max(0.75, w * 0.099) : step === 2 ? Math.max(1.15, w * 0.22) : Math.max(1.55, w * 0.36);
        for (let i = 0; i < palette.length; i++) {
          const s = (step - 1) * 38 + i;
          const x = (s % 32) * pw + 1;
          const y = Math.floor(s / 32) * ph + 1;
          const cx = Math.floor(x + sw / 2) + 0.5;
          const cy = Math.floor(y + sh / 2) + 0.5;
          actx.fillStyle = palette[i] || palette[0];
          actx.beginPath();
          actx.arc(cx, cy, r, 0, Math.PI * 2);
          actx.fill();
        }
      }

      xs = Int32Array.from({ length: cols + 1 }, (_, x) => Math.round(x * w));
      ys = Int32Array.from({ length: rows + 1 }, (_, y) => Math.round(y * h));
      gx = Int32Array.from({ length: cols }, (_, x) => Math.round(x * w + (w - sw) / 2));
      gy = Int32Array.from({ length: rows }, (_, y) => Math.round(y * h + (h - sh) / 2));
      full = true;
    };

    let t = initialTime;
    let currentOffset = 0;
    const draw = () => {
      const { densities, cols: frameCols } = frame(t, { parallaxOffset: currentOffset });
      if (full) {
        ctx.fillStyle = ground;
        ctx.fillRect(0, 0, canvas.width, canvas.height);
      }
      for (let y = 0, i = 0; y < rows; y++) {
        const y0 = ys[y],
          ch = ys[y + 1] - y0;
        for (let x = 0; x < cols; x++, i++) {
          const d = densities[i],
            c = frameCols[i];
          if (full || d !== lastDensity[i] || c !== lastColor[i]) {
            const x0 = xs[x],
              cw = xs[x + 1] - x0;
            if (!full) {
              ctx.fillStyle = ground;
              ctx.fillRect(x0, y0, cw, ch);
            }
            if (d !== 0) {
              const s = (d - 1) * 38 + c;
              ctx.drawImage(atlas, (s % 32) * pw + 1 + x0 - gx[x], Math.floor(s / 32) * ph + 1 + y0 - gy[y], cw, ch, x0, y0, cw, ch);
            }
          }
        }
      }
      lastDensity.set(densities);
      lastColor.set(frameCols);
      full = false;
    };

    size();

    let lastTime = performance.now();
    let raf = 0;
    const tick = (now: number) => {
      raf = requestAnimationFrame(tick);
      const dt = now - lastTime;
      if (dt < 1000 / fps - 2) return;
      lastTime = now;
      t += Math.min(dt, 100) / 1000;
      draw();
    };

    draw();
    raf = requestAnimationFrame(tick);

    return {
      stop() {
        if (raf) cancelAnimationFrame(raf);
      },
      getTime() {
        return t;
      },
      setParallaxOffset(offset: number) {
        if (Math.abs(offset - currentOffset) > 0.05) {
          currentOffset = offset;
          draw();
        }
      },
    };
  }

  const canvas = document.getElementById("art") as HTMLCanvasElement | null;
  const heroOverlay = document.querySelector(".hero-overlay") as HTMLElement | null;
  let parallaxScheduled = false;
  let currentRows = 0;
  let currentCanvasWidth = 0;
  let currentApp: any = null;
  let sharedTime = 0;

  function applyParallax() {
    if (!canvas) return;
    const scrollY = window.pageYOffset || document.documentElement.scrollTop || 0;
    if (currentApp && currentApp.setParallaxOffset && canvas) {
      const frame = document.getElementById("frame");
      const isMobile = window.innerWidth <= 680;
      const isTabletPortrait = window.innerWidth > 680 && window.innerWidth <= 1024 && window.innerHeight > window.innerWidth;
      const trackHeight = frame ? frame.clientHeight : canvas.clientHeight || 600;
      const progress = Math.min(1.0, scrollY / Math.max(350, trackHeight));
      const rowOffset = progress * 19;
      currentApp.setParallaxOffset(rowOffset);

      if (heroOverlay) {
        const rowHeightPx = (canvas.clientHeight || canvas.clientWidth * (currentRows / 200) || 600) / Math.max(1, currentRows);
        const speed = isMobile ? 0.53 : isTabletPortrait ? 0.46 : 0.4;
        const textOffsetY = rowOffset * rowHeightPx * speed;
        heroOverlay.style.transform = `translate3d(0, ${textOffsetY.toFixed(2)}px, 0)`;
      }
    }
    parallaxScheduled = false;
  }

  window.addEventListener(
    "scroll",
    () => {
      if (!parallaxScheduled) {
        parallaxScheduled = true;
        requestAnimationFrame(applyParallax);
      }
    },
    { passive: true },
  );

  function update(force = false) {
    if (!canvas) return;
    const isMobile = window.matchMedia("(max-width: 680px)").matches;
    const isTabletPortrait = window.matchMedia("(min-width: 681px) and (max-width: 1024px) and (orientation: portrait)").matches;
    const aspect = window.innerWidth / window.innerHeight;
    const screenRows = aspect >= 16 / 9 ? 112 : Math.min(180, Math.round(200 / aspect));
    const totalRows = screenRows + 10;
    const extraSky = screenRows - 112 + 10;

    document.documentElement.style.setProperty("--art-rows", String(totalRows));
    canvas.style.aspectRatio = `200 / ${totalRows}`;
    const vWidth = isMobile ? 300 : isTabletPortrait ? 200 : 100;
    canvas.style.height = `${(totalRows / 200) * vWidth}vw`;

    if (totalRows === currentRows && canvas.clientWidth === currentCanvasWidth && !force) return;
    currentRows = totalRows;
    currentCanvasWidth = canvas.clientWidth;

    const meta = {
      ...baseMeta,
      rows: totalRows,
    };

    if (currentApp) {
      sharedTime = currentApp.getTime ? currentApp.getTime() : 0;
      currentApp.stop();
    }

    currentApp = mount(canvas, meta, () => createEarthrise(totalRows, extraSky), sharedTime);
    applyParallax();
  }

  let resizeTimer: any = null;
  window.addEventListener("resize", () => {
    clearTimeout(resizeTimer);
    resizeTimer = setTimeout(update, 80);
  });

  const init = () => {
    update();
    applyParallax();
  };

  if (canvas) {
    init();
  }
</script>
