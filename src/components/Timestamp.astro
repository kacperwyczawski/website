---
export interface Props {
  date: string;
  location: string;
  head: string;
  tail: string;
  tailUrl: string;
  type?: string | undefined;
}

const { date, location, head, tail, tailUrl, type } = Astro.props;
const isCurrent = date.includes("present") || date.includes("obecnie");
---

<li class="relative group pb-8 last:pb-2 list-none">
  <div class="absolute left-4 top-0 -bottom-8 w-px bg-zinc-800 group-first:top-3.5 group-last:bottom-2" aria-hidden="true"></div>
  <div class="flex items-center gap-3 relative z-10 flex-wrap sm:flex-nowrap">
    <span class="inline-flex items-center gap-1.5 px-2.5 py-1 border border-zinc-800 bg-zinc-950 rounded-md text-sm font-heading font-normal text-zinc-400 shadow-sm shrink-0">
      {isCurrent && (
        <span class="relative flex h-2 w-2 shrink-0">
          <span
            class="animate-ping absolute inline-flex h-full w-full rounded-full bg-sky-400 opacity-75"
            style="animation-duration: 3s"
          ></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-sky-500"></span>
        </span>
      )}
      {date}
    </span>
    <span class="text-zinc-500 text-sm font-heading">
      {location}
      {type && ` · ${type}`}
    </span>
  </div>

  <div class="ml-4 pl-6 pt-3">
    <div class="text-xl font-heading font-semibold text-zinc-100">
      {head}{" "}
      <a href={tailUrl} class="underline decoration-zinc-600 hover:decoration-white hover:text-white transition-colors">
        {tail}
      </a>
    </div>
    {Astro.slots.has("description") && (
      <div class="prose mt-1.5 leading-relaxed text-zinc-400 text-base">
        <slot name="description" />
      </div>
    )}
    <ul class="list-none p-0 m-0 mt-3 space-y-2.5 text-zinc-400 font-body">
      <slot />
    </ul>
  </div>
</li>
