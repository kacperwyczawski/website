---
export interface Props {
  emphasis?: boolean;
  class?: string;
}

const { emphasis = false, class: additionalClass = "" } = Astro.props;
---

<span
  class:list={[
    "inline-flex items-center px-2.5 py-1 border rounded-md text-sm font-heading font-normal",
    emphasis ? "border-zinc-700 bg-zinc-900 text-zinc-100" : "border-zinc-800 bg-zinc-950 text-zinc-400",
    additionalClass,
  ]}
>
  <slot />
</span>
