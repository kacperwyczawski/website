---
export interface Props {
  text: string;
  link: string;
}

const { link, text } = Astro.props;
---

<a href={link} class="group text-neutral-400 text-center my-6 transition-colors hover:text-neutral-100">
  {text}
  <span class="group-hover:translate-x-2 inline-block transition-transform">-&gt;</span>
</a>
