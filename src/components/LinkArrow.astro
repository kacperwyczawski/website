---
export interface Props {
  text: string;
  link: string;
}

const { link, text } = Astro.props;
---

<a
  href={link}
  class="group font-heading text-sm sm:text-base text-zinc-400 hover:text-white my-6 inline-flex items-center gap-1.5 transition-colors no-underline"
>
  {text}
  <span class="group-hover:translate-x-1.5 inline-block transition-transform duration-150">&rarr;</span>
</a>
