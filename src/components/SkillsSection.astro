---
import Chip from "./Chip.astro";

const skills = {
  languages: {
    preferred: ["C#", "HTML", "CSS", "JavaScript", "TypeScript", "SQL"],
    nonPreferred: ["F#", "C++", "PHP", "Python"],
  },
  backend: {
    preferred: ["ASP.NET Core", "PostgreSQL"],
    nonPreferred: ["Laravel", "SQLite", "MySQL"],
  },
  frontend: {
    preferred: ["Blazor", "Tailwind CSS", "Astro", "Vue"],
    nonPreferred: ["Nuxt", "WebAssembly", "Bootstrap"],
  },
  other: {
    preferred: ["Docker", "Git", "Linux", "Unit Testing"],
    nonPreferred: ["Nix", "CI/CD", "Figma"],
  },
};

interface Props {
  type: keyof typeof skills;
  name: string;
}

const { type, name } = Astro.props;
---

<li class="flex flex-col">
  <h3 class="font-heading text-xl font-semibold text-zinc-100 mb-3 tracking-tight leading-snug">{name}</h3>
  <div class="flex flex-wrap gap-2">
    {skills[type].preferred.map((item) => (
      <Chip emphasis>{item}</Chip>
    ))}
    {skills[type].nonPreferred.map((item) => (
      <Chip>{item}</Chip>
    ))}
  </div>
</li>
