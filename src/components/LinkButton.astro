---
export interface Props {
  text: string;
  link: string;
}

const { link, text } = Astro.props;
---

<a
  href={link}
  class="block rounded-md border border-zinc-700 hover:border-zinc-600 bg-zinc-950 hover:bg-zinc-800 text-zinc-300 hover:text-white text-center py-2.5 px-4 grow transition-all duration-150 font-heading text-sm font-medium shadow-sm no-underline"
>
  {text}
</a>
