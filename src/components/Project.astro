---
import arxChessImage from "@images/arx-chess.png";
import autoCutImage from "@images/autocut.png";
import elektronetImage from "@images/elektronet.png";
import nixosImage from "@images/nixos.png";
import sigmaCarsImage from "@images/sigma-cars.png";
import Chip from "./Chip.astro";
import LinkButton from "./LinkButton.astro";
import Mockup from "./Mockup.astro";

interface Props {
  name: keyof typeof projects;
}

const { name } = Astro.props;

const projects = {
  nixos: {
    name: "NixOS.org",
    status: null,
    technologies: ["Astro", "Tailwind CSS", "TypeScript", "Nix", "DaisyUI", "MDX"],
    sourceUrl: "https://github.com/NixOS/nixos-homepage",
    liveUrl: "https://nixos.org",
    image: nixosImage,
  },
  elektronet: {
    name: "Elektronet",
    status: null,
    technologies: ["PHP", "Laravel", "FilamentPHP", "Tailwind CSS", "SQLite", "Docker", "Portainer", "Caddy", "Traefik"],
    sourceUrl: "https://github.com/kacperwyczawski/elektronet",
    liveUrl: "https://elektronet.zse.rzeszow.pl",
    image: elektronetImage,
  },
  arxchess: {
    name: "Arx Chess",
    status: "beta",
    technologies: ["Vite", "Vercel", "TypeScript", "Nix"],
    sourceUrl: "https://github.com/kacperwyczawski/arx-chess",
    liveUrl: "https://arx.wyczawski.dev",
    image: arxChessImage,
  },
  autocut: {
    name: "AutoCut",
    status: "beta",
    technologies: ["Vite", "Vue", "TypeScript", "Nix"],
    sourceUrl: "https://github.com/kacperwyczawski/autocut",
    liveUrl: "https://autocut.wyczawski.dev",
    image: autoCutImage,
  },
  sigmacars: {
    name: "Sigma Cars",
    status: "beta",
    technologies: ["Docker", "C#", "ASP.NET Core", "EF Core", "PostgreSQL", "Nuxt", "Vue", "Tailwind CSS", "TypeScript", "CI/CD", "Nginx"],
    sourceUrl: "https://github.com/kacperwyczawski/sigma-cars",
    liveUrl: null,
    image: sigmaCarsImage,
  },
  website: {
    name: "Wyczawski.dev",
    status: null,
    technologies: ["Astro", "Tailwind CSS", "TypeScript", "Nix"],
    sourceUrl: "https://github.com/kacperwyczawski/website",
    liveUrl: null,
    image: null,
  },
};

const project = projects[name];
---

<div class="bg-zinc-950/90 border border-zinc-800 rounded-lg overflow-hidden shadow-lg">
  {project.image && <Mockup image={project.image} alt={project.name + " mockup"} url={project.liveUrl ?? project.sourceUrl} />}
  <div class="p-5 sm:p-6 flex flex-col gap-4">
    <h3 class="text-2xl font-heading font-semibold text-zinc-100">
      {project.name}
      {project.status && <span class="text-xs font-heading font-normal text-zinc-500 ml-2">({project.status})</span>}
    </h3>
    <div class="flex gap-1.5 sm:gap-2 flex-wrap">
      {project.technologies.map((tech) => (
        <Chip>{tech}</Chip>
      ))}
    </div>
    <p class="prose max-w-none text-zinc-400 leading-relaxed">
      <slot />
    </p>
    <div class="grid grid-flow-col auto-cols-fr gap-4">
      {project.sourceUrl && <LinkButton text="Source" link={project.sourceUrl} />}
      {project.liveUrl && <LinkButton text="Live" link={project.liveUrl} />}
    </div>
  </div>
</div>
