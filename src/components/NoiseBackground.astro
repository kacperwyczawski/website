---
---
<canvas id="noise-bg" class="fixed inset-0 w-full h-full -z-10 pointer-events-none" style="filter: blur(3px) saturate(1.2); transform: scale(1.02);"></canvas>

<script>
  import { createNoise3D } from 'simplex-noise';

  const noise3D = createNoise3D();
  const canvas = document.getElementById('noise-bg') as HTMLCanvasElement;
  const ctx = canvas.getContext('2d');

  const PIXEL_SIZE = 48;

  let width = 0;
  let height = 0;
  let cols = 0;
  let rows = 0;

  function resize() {
    width = window.innerWidth;
    height = window.innerHeight;
    
    cols = Math.ceil(width / PIXEL_SIZE);
    rows = Math.ceil(height / PIXEL_SIZE);
    
    canvas.width = width;
    canvas.height = height;
  }

  window.addEventListener('resize', resize);
  resize();

  let time = 0;

  function getColors() {
    const style = getComputedStyle(document.documentElement);
    const parseRGB = (varName: string) => {
      const val = style.getPropertyValue(varName);
      if (!val) return { r: 0, g: 0, b: 0 };
      const parts = val.trim().split(/\s+/).map(n => parseInt(n, 10));
      return { r: parts[0] || 0, g: parts[1] || 0, b: parts[2] || 0 };
    };
    return {
      primaryA: parseRGB('--primary-a-channels'),
      primaryB: parseRGB('--primary-b-channels'),
    };
  }

  let currentColors = getColors();
  
  // Need to read after initial styles apply
  requestAnimationFrame(() => {
    currentColors = getColors();
  });

  const observer = new MutationObserver(() => {
    currentColors = getColors();
  });
  observer.observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });

  window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', () => {
    currentColors = getColors();
  });

  function lerpColor(a: {r:number,g:number,b:number}, b: {r:number,g:number,b:number}, t: number) {
    return {
      r: Math.round(a.r + (b.r - a.r) * t),
      g: Math.round(a.g + (b.g - a.g) * t),
      b: Math.round(a.b + (b.b - a.b) * t)
    };
  }

  function render() {
    if (!ctx) return;
    
    time += 0.0008;

    const colors = currentColors;

    ctx.clearRect(0, 0, width, height);

    for (let x = 0; x < cols; x++) {
      for (let y = 0; y < rows; y++) {
        const distortion = noise3D(x * 0.04, y * 0.04, time);
        const wave = Math.sin(x * 0.1 + y * 0.2 + distortion * 2.5);
        
        const dx = 1;
        const dy = -1;
        const distortionOffset = noise3D((x + dx) * 0.04, (y + dy) * 0.04, time);
        const waveOffset = Math.sin((x + dx) * 0.1 + (y + dy) * 0.2 + distortionOffset * 2.5);
        const slope = waveOffset - wave;

        let blend = 0;
        if (wave > 0.3) {
          blend = (wave - 0.3) / 0.7;
        }

        blend = Math.floor(blend * 8) / 7; 
        blend = Math.max(0, Math.min(1, blend));

        let lightMix = (slope + 0.15) / 0.3;
        lightMix = Math.max(0, Math.min(1, lightMix));
        
        const smudgeColor = lerpColor(colors.primaryB, colors.primaryA, lightMix);

        const px = x * PIXEL_SIZE;
        const py = y * PIXEL_SIZE;

        if (blend > 0) {
          ctx.fillStyle = `rgba(${smudgeColor.r}, ${smudgeColor.g}, ${smudgeColor.b}, ${blend})`;
          ctx.fillRect(px, py, PIXEL_SIZE, PIXEL_SIZE);
        }
      }
    }

    requestAnimationFrame(render);
  }

  render();
</script>
