    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" href="/hero-title.svg" as="image" type="image/svg+xml" fetchpriority="high" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <title>Kacper Wyczawski</title>
  </head>
  <body class="flex min-h-screen flex-col bg-zinc-950 text-zinc-300 selection:bg-sky-500/30 selection:text-sky-100">
    <slot />
  </body>
</html>
