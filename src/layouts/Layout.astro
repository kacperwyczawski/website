---
import "../styles/global.css";

interface Props {
  en?: boolean;
}
const { en } = Astro.props;
const currentPath = Astro.url.pathname;
const plUrl = !en ? undefined : `/pl${currentPath === "/" ? "" : currentPath}`;
const enUrl = en ? undefined : currentPath.replace(/^\/pl(\/|$)/, "/$1").replace(/\/\/+/, "/") || "/";
---

<!doctype html>
<html lang={en ? "en" : "pl"} class="dark h-full">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#09090b" />
    <meta name="description" content="Kacper Wyczawski's website" />
    <meta property="og:title" content="Kacper Wyczawski's website" />
    <meta property="og:description" content="Kacper is a web developer and open-source enthusiast." />
    <meta property="og:url" content={import.meta.env.SITE} />
    <meta property="og:type" content="profile" />
    <meta property="og:profile:first_name" content="Kacper" />
    <meta property="og:profile:last_name" content="Wyczawski" />
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "ProfilePage",
        "dateCreated": "2024-02-24T18:51:11+0000",
        "mainEntity": {
          "@type": "Person",
          "name": "Kacper Wyczawski",
          "description": "Kacper is a web developer, open-source enthusiast and student.",
          "sameAs": ["https://github.com/kacperwyczawski"]
        }
      }
    </script>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <title>Kacper Wyczawski</title>
    <style>
      #lang-select {
        opacity: 0;
        pointer-events: none;
        transition: opacity 0.2s ease;
      }

      #lang-select.is-scrolled {
        opacity: 1;
        pointer-events: auto;
      }
    </style>
  </head>
  <body class="flex min-h-screen flex-col bg-zinc-950 text-zinc-300 selection:bg-sky-500/30 selection:text-sky-100">
    <slot />
    <aside
      id="lang-select"
      aria-label="Language selection"
      class="fixed bottom-5 right-5 z-50 inline-flex items-center rounded-lg border border-zinc-800 bg-zinc-950/90 shadow-md backdrop-blur-md text-xs font-mono select-none overflow-hidden divide-x divide-zinc-800"
    >
      <a
        href={plUrl}
        class:list={[
          "px-3 py-1.5 flex items-center justify-center leading-none transition-colors",
          !en ? "bg-zinc-800 text-zinc-100 font-semibold pointer-events-none" : "text-zinc-400 hover:text-zinc-100 hover:bg-zinc-900/60",
        ]}
      >
        PL
      </a>
      <a
        href={enUrl}
        class:list={[
          "px-3 py-1.5 flex items-center justify-center leading-none transition-colors",
          en ? "bg-zinc-800 text-zinc-100 font-semibold pointer-events-none" : "text-zinc-400 hover:text-zinc-100 hover:bg-zinc-900/60",
        ]}
      >
        EN
      </a>
    </aside>

    <script>
      const updateLang = () => {
        const hasArtwork = document.getElementById("frame") !== null;
        const isScrolled = !hasArtwork || window.scrollY > 60;
        document.getElementById("lang-select")?.classList.toggle("is-scrolled", isScrolled);
      };
      window.addEventListener("scroll", updateLang, { passive: true });
      updateLang();
    </script>
  </body>
</html>
