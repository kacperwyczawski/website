---
import "../styles/global.css";
---

<!doctype html>
<html lang="en" class="dark h-full">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#09090b" />
    <meta name="description" content="Kacper Wyczawski's website" />
    <meta property="og:title" content="Kacper Wyczawski's website" />
    <meta property="og:description" content="Kacper is a software developer and aspiring satellite engineer" />
    <meta property="og:url" content={import.meta.env.SITE} />
    <meta property="og:type" content="profile" />
    <meta property="og:profile:first_name" content="Kacper" />
    <meta property="og:profile:last_name" content="Wyczawski" />
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "ProfilePage",
        "dateCreated": "2024-02-24T18:51:11+0000",
        "mainEntity": {
          "@type": "Person",
          "name": "Kacper Wyczawski",
          "description": "Kacper is a software developer and aspiring satellite engineer",
          "sameAs": ["https://github.com/kacperwyczawski"]
        }
