---
import "../styles/global.css";
import { Font } from "astro:assets";

interface Props {
  en?: boolean;
}
const { en } = Astro.props;
const currentPath = Astro.url.pathname;
const plUrl = !en ? undefined : `/pl${currentPath === "/" ? "" : currentPath}`;
const enUrl = en ? undefined : currentPath.replace(/^\/pl(\/|$)/, "/$1").replace(/\/\/+/, "/") || "/";
---

<!doctype html>
<html lang={en ? "en" : "pl"} class="dark h-full">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <Font cssVariable="--font-inter" preload />
    <Font cssVariable="--font-sora" preload />
    <Font cssVariable="--font-fira-code" preload />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#a21caf" />
    <meta name="description" content="Kacper Wyczawski's website" />
    <meta property="og:title" content="Kacper Wyczawski's website" />
    <meta property="og:description" content="Kacper is a web developer and open-source enthusiast." />
    <meta property="og:url" content={import.meta.env.SITE} />
    <meta property="og:type" content="profile" />
    <meta property="og:profile:first_name" content="Kacper" />
    <meta property="og:profile:last_name" content="Wyczawski" />
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "ProfilePage",
        "dateCreated": "2024-02-24T18:51:11+0000",
        "mainEntity": {
          "@type": "Person",
          "name": "Kacper Wyczawski",
          "description": "Kacper is a web developer, open-source enthusiast and student.",
          "sameAs": ["https://github.com/kacperwyczawski"]
        }
      }
    </script>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <title>Kacper Wyczawski</title>
    <style>
      html {
        scroll-behavior: smooth;
      }

      body {
        --grid-color: color-mix(in oklch, var(--color-slate-800) 70%, transparent);
        background-size: 32px 32px;
        background-image:
          linear-gradient(to right, var(--grid-color) 1px, transparent 1px),
          linear-gradient(to bottom, var(--grid-color) 1px, transparent 1px);
        background-position: 10px 10px;
        background-attachment: fixed;
      }
    </style>
  </head>
  <body class="selection:bg-fuchsia-700/20 text-neutral-100 flex flex-col bg-slate-900 scheme-dark">
    <slot />
    <aside
      aria-label="Language selection"
      class="fixed bottom-6 right-6 z-50 flex items-center rounded-full border border-slate-800 bg-slate-850/80 p-1 text-sm font-semibold shadow-lg backdrop-blur-sm text-neutral-100"
    >
      <a
        href={plUrl}
        class:list={[
          "rounded-full px-3 py-1 transition-colors",
          !en ? "bg-fuchsia-600 text-white pointer-events-none" : "text-neutral-300 hover:text-fuchsia-400",
        ]}
      >
        PL
      </a>
      <a
        href={enUrl}
        class:list={[
          "rounded-full px-3 py-1 transition-colors",
          en ? "bg-fuchsia-600 text-white pointer-events-none" : "text-neutral-300 hover:text-fuchsia-400",
        ]}
      >
        EN
      </a>
    </aside>
  </body>
</html>
